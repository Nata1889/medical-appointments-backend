generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  patient Patient?
  doctor  Doctor?

  @@index([lastName, firstName])
}

model Patient {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  phone     String?
  birthDate DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Specialty {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  doctors Doctor[]
}

model Doctor {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  specialtyId         String   @db.Uuid
  professionalLicense String   @unique
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty      Specialty      @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  availabilities Availability[]
  appointments   Appointment[]

  @@index([specialtyId])
}

model Availability {
  id                  String   @id @default(uuid()) @db.Uuid
  doctorId            String   @db.Uuid
  weekDay             WeekDay
  startTimeMinutes    Int
  endTimeMinutes      Int
  slotDurationMinutes Int
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, weekDay, startTimeMinutes, endTimeMinutes])
  @@index([doctorId, weekDay])
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @db.Uuid
  doctorId    String            @db.Uuid
  scheduledAt DateTime          @db.Timestamptz(3)
  reason      String?
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
}
